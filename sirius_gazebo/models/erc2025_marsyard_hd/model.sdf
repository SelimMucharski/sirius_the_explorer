<?xml version="1.0"?>
<!-- Copy of erc2025_marsyard with the gravel texture (marsyard_dressing/generate_dressing.py) -->
<sdf version="1.9">
  <model name="erc2025_marsyard_hd">
    <static>true</static>
    <link name="link">
      <collision name="collision">
        <geometry>
          <mesh><uri>meshes/erc2025_marsyard_collision.obj</uri></mesh>
        </geometry>
        <surface>
          <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
        </surface>
      </collision>
      <visual name="visual">
        <geometry>
          <mesh><uri>meshes/erc2025_marsyard.obj</uri></mesh>
        </geometry>
      </visual>
    </link>
  </model>
</sdf>
