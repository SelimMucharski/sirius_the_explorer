  <disable_collisions link1="back_left_outer_rim" link2="front_left_suspension" reason="Never"/>
  <disable_collisions link1="back_left_outer_rim" link2="front_left_wheel" reason="Never"/>
  <disable_collisions link1="back_left_outer_rim" link2="front_right_inner_rim" reason="Never"/>
