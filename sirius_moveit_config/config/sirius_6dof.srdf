<?xml version="1.0" encoding="UTF-8"?>
<!--
  Semantic robot description for the Sirius rover with 6-DOF manipulator.

  Joint chain (6DOF):
    root_link → joint_1 → link_1 → joint_2 → link_2 → joint_3 → link_3
             → joint_4 → link_4 → joint_5 → link_5 → joint_6 → tcp_connector
-->
<robot name="sirius">

  <!-- ================================================================
       Planning groups
       ================================================================ -->

  <group name="arm">
    <chain base_link="root_link" tip_link="tcp_connector"/>
  </group>

  <!-- Parallel gripper; both jaws are commanded together -->
  <group name="gripper">
    <link name="gripper_left"/>
    <link name="gripper_right"/>
    <joint name="joint_gripper_left"/>
    <joint name="joint_gripper_right"/>
  </group>

  <!-- Wrist sub-group (last 3 joints) -->
  <group name="wrist">
    <chain base_link="link_3" tip_link="tcp_connector"/>
  </group>


  <!-- ================================================================
       Named states
       ================================================================ -->

  <group_state name="home" group="arm">
    <joint name="joint_1" value="0"/>
    <joint name="joint_2" value="0"/>
    <joint name="joint_3" value="0"/>
    <joint name="joint_4" value="0"/>
    <joint name="joint_5" value="0"/>
    <joint name="joint_6" value="0"/>
  </group_state>

  <!-- Arm folded upright for safe travel -->
  <group_state name="upright" group="arm">
    <joint name="joint_1" value="0"/>
    <joint name="joint_2" value="-1.0"/>
    <joint name="joint_3" value="1.2"/>
    <joint name="joint_4" value="0"/>
    <joint name="joint_5" value="0"/>
    <joint name="joint_6" value="0"/>
  </group_state>

  <!-- Arm extended horizontally forward -->
  <group_state name="ready" group="arm">
    <joint name="joint_1" value="0"/>
    <joint name="joint_2" value="-0.3"/>
    <joint name="joint_3" value="0.6"/>
    <joint name="joint_4" value="0"/>
    <joint name="joint_5" value="0"/>
    <joint name="joint_6" value="0"/>
  </group_state>


  <!-- Arm reaching forward, away from singularities (Jacobian condition number ~14);
       start here before jogging with MoveIt Servo. home/upright/ready have
       joint_5 = 0, i.e. a wrist singularity where Servo stops immediately. -->
  <group_state name="work" group="arm">
    <joint name="joint_1" value="0"/>
    <joint name="joint_2" value="0.5"/>
    <joint name="joint_3" value="1.0"/>
    <joint name="joint_4" value="0"/>
    <joint name="joint_5" value="0.8"/>
    <joint name="joint_6" value="0"/>
  </group_state>

  <!-- ================================================================
       End-effector
       ================================================================ -->

  <group_state name="open" group="gripper">
    <joint name="joint_gripper_left" value="0.0326"/>
    <joint name="joint_gripper_right" value="0.0326"/>
  </group_state>

  <group_state name="closed" group="gripper">
    <joint name="joint_gripper_left" value="0"/>
    <joint name="joint_gripper_right" value="0"/>
  </group_state>

  <end_effector name="gripper_eef" parent_link="tcp_connector" group="gripper" parent_group="arm"/>


  <!-- ================================================================
       Passive joints
       ================================================================ -->

  <passive_joint name="front_left_wheel_joint"/>
  <passive_joint name="back_left_wheel_joint"/>
  <passive_joint name="front_right_wheel_joint"/>
  <passive_joint name="back_right_wheel_joint"/>


  <!-- ================================================================
       Collision matrix
       ================================================================ -->

  <disable_collisions link1="root_link"  link2="link_1" reason="Adjacent"/>
  <disable_collisions link1="link_1"     link2="link_2" reason="Adjacent"/>
  <disable_collisions link1="link_2"     link2="link_3" reason="Adjacent"/>
  <disable_collisions link1="link_3"     link2="link_4" reason="Adjacent"/>
  <disable_collisions link1="link_4"     link2="link_5" reason="Adjacent"/>
  <disable_collisions link1="link_5"     link2="tcp_connector" reason="Adjacent"/>
  <disable_collisions link1="tcp_connector" link2="gripper_left"  reason="Adjacent"/>
  <disable_collisions link1="tcp_connector" link2="gripper_right" reason="Adjacent"/>
  <disable_collisions link1="tcp_connector" link2="wrist_camera"  reason="Adjacent"/>
  <!-- Jaws touch each other when the gripper is closed -->
  <disable_collisions link1="gripper_left"  link2="gripper_right" reason="Default"/>

  <!-- Rover body: rigid (wheels/rims are axisymmetric), so distances between its links never
       change; checking them only makes MoveIt Servo decelerate permanently. -->
  <disable_collisions link1="back_left_inner_rim" link2="back_left_outer_rim" reason="Never"/>
  <disable_collisions link1="back_left_inner_rim" link2="back_left_suspension" reason="Never"/>
  <disable_collisions link1="back_left_inner_rim" link2="back_left_wheel" reason="Never"/>
  <disable_collisions link1="back_left_inner_rim" link2="back_right_inner_rim" reason="Never"/>
  <disable_collisions link1="back_left_inner_rim" link2="back_right_outer_rim" reason="Never"/>
  <disable_collisions link1="back_left_inner_rim" link2="back_right_suspension" reason="Never"/>
  <disable_collisions link1="back_left_inner_rim" link2="back_right_wheel" reason="Never"/>
  <disable_collisions link1="back_left_inner_rim" link2="front_camera" reason="Never"/>
  <disable_collisions link1="back_left_inner_rim" link2="front_left_inner_rim" reason="Never"/>
  <disable_collisions link1="back_left_inner_rim" link2="front_left_outer_rim" reason="Never"/>
  <disable_collisions link1="back_left_inner_rim" link2="front_left_suspension" reason="Never"/>
  <disable_collisions link1="back_left_inner_rim" link2="front_left_wheel" reason="Never"/>
  <disable_collisions link1="back_left_inner_rim" link2="front_right_inner_rim" reason="Never"/>
  <disable_collisions link1="back_left_inner_rim" link2="front_right_outer_rim" reason="Never"/>
  <disable_collisions link1="back_left_inner_rim" link2="front_right_suspension" reason="Never"/>
  <disable_collisions link1="back_left_inner_rim" link2="front_right_wheel" reason="Never"/>
  <disable_collisions link1="back_left_inner_rim" link2="gnss" reason="Never"/>
  <disable_collisions link1="back_left_inner_rim" link2="indicator_light" reason="Never"/>
  <disable_collisions link1="back_left_inner_rim" link2="mast_back_camera" reason="Never"/>
  <disable_collisions link1="back_left_inner_rim" link2="mast_front_camera" reason="Never"/>
  <disable_collisions link1="back_left_inner_rim" link2="platform" reason="Never"/>
  <disable_collisions link1="back_left_outer_rim" link2="back_left_suspension" reason="Never"/>
  <disable_collisions link1="back_left_outer_rim" link2="back_left_wheel" reason="Never"/>
  <disable_collisions link1="back_left_outer_rim" link2="back_right_inner_rim" reason="Never"/>
  <disable_collisions link1="back_left_outer_rim" link2="back_right_outer_rim" reason="Never"/>
  <disable_collisions link1="back_left_outer_rim" link2="back_right_suspension" reason="Never"/>
