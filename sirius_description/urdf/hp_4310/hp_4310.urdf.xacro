<robot xmlns:xacro="http://wiki.ros.org/xacro">
<xacro:macro name="hp_4310" params="prefix:=hp_4310 material cameras:=${xacro.load_yaml('$(find sirius_description)/urdf/hp_4310/collisions.yaml')}">
  <link name="${prefix}_camera">
    <visual>
      <material name="${material}"/>
      <geometry>
        <box size="${cameras['hp_4310_thickness']} ${cameras['hp_4310_width']} ${cameras['hp_4310_height']}"/>
      </geometry>
      <origin xyz="${-cameras['hp_4310_thickness']/2} 0 0"/>
    </visual>
    <collision>
      <geometry>
        <box size="${cameras['hp_4310_thickness']} ${cameras['hp_4310_width']} ${cameras['hp_4310_height']}"/>
      </geometry>
      <origin xyz="${-cameras['hp_4310_thickness']/2} 0 0"/>
    </collision>
  </link>
</xacro:macro>
</robot>