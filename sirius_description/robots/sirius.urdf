    <parent link="front_camera_imu_link"/>
    <child link="front_camera_imu_link_ned"/>
  </joint>
  <gazebo reference="front_right_camera_optical">
    <sensor name="front_left" type="camera">
      <visualize>true</visualize>
      <update_rate>30</update_rate>
      <topic>front/left/image_raw</topic>
      <gz_frame_id>front_left_camera_optical</gz_frame_id>
      <pose>-0.07532288828882855 -0.00023578074521742642 0.009450869333471749 1.5669054092956256 -1.5814847581233877 0.005441182065086076</pose>
      <camera>
        <horizontal_fov>1.6891194873393693</horizontal_fov>
        <image>
          <width>320</width>
          <height>240</height>
          <format>L8</format>
        </image>
        <clip>
          <near>0.1</near>
          <far>100</far>
        </clip>
      </camera>
    </sensor>
    <sensor name="front_right" type="camera">
      <visualize>true</visualize>
      <update_rate>30</update_rate>
      <topic>front/right/image_raw</topic>
      <gz_frame_id>front_right_camera_optical</gz_frame_id>
      <pose>0 0 0.01 1.5707963267948966 -1.5707963267948966 0</pose>
      <camera>
        <horizontal_fov>1.6891194873393693</horizontal_fov>
        <image>
          <width>320</width>
          <height>240</height>
          <format>L8</format>
        </image>
        <clip>
          <near>0.1</near>
          <far>100</far>
        </clip>
      </camera>
    </sensor>
  </gazebo>
  <gazebo reference="front_camera">
    <sensor name="front_camera" type="rgbd_camera">
      <topic>front/camera</topic>
      <gz_frame_id>front_camera</gz_frame_id>
      <pose>0 0 0 0 0 0</pose>
      <always_on>1</always_on>
      <update_rate>30</update_rate>
      <camera name="front_camera_depth">
        <horizontal_fov>1.6891194873393693</horizontal_fov>
        <image>
          <width>320</width>
          <height>240</height>
          <format>R8G8B8</format>
        </image>
        <lens>
          <intrinsics>
            <fx>568.758493707557</fx>
            <fy>568.0898833961045</fy>
            <cx>633.8144842785725</cx>
            <cy>346.30987409946977</cy>
            <s>0</s>
          </intrinsics>
        </lens>
        <distortion>
          <k1>0.024797346405976157</k1>
          <k2>-0.06685379106623551</k2>
          <k3>0.07272744476764836</k3>
          <p1>-0.0242044946199227</p1>
          <p2>0.0</p2>
          <center>0.5 0.5</center>
        </distortion>
        <clip>
          <near>0.02</near>
          <far>300</far>
        </clip>
        <depth_camera>
          <clip>
            <near>0.35</near>
            <far>35.0</far>
          </clip>
        </depth_camera>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.007</stddev>
        </noise>
      </camera>
    </sensor>
  </gazebo>
  <gazebo reference="front_camera_imu_link">
    <sensor name="front_imu_sensor" type="imu">
      <always_on>1</always_on>
      <update_rate>200.0</update_rate>
      <topic>front/imu/data</topic>
      <gz_frame_id>front_camera_imu_link</gz_frame_id>
      <imu>
        <!-- Wyłączamy orientację, jeśli ma być liczona przez zewnętrzny filtr (np. EKF) -->
        <enable_orientation>0</enable_orientation>
        <angular_velocity>
          <x>
            <noise type="gaussian">
              <mean>0</mean>
              <stddev>0.02197620500510835</stddev>
              <dynamic_bias_stddev>3.537796689331736e-05</dynamic_bias_stddev>
            </noise>
          </x>
          <y>
            <noise type="gaussian">
              <mean>0</mean>
              <stddev>0.02197620500510835</stddev>
              <dynamic_bias_stddev>3.537796689331736e-05</dynamic_bias_stddev>
            </noise>
          </y>
          <z>
            <noise type="gaussian">
              <mean>0</mean>
              <stddev>0.02197620500510835</stddev>
              <dynamic_bias_stddev>3.537796689331736e-05</dynamic_bias_stddev>
            </noise>
          </z>
        </angular_velocity>
        <linear_acceleration>
          <x>
            <noise type="gaussian">
              <mean>0</mean>
              <stddev>0.144874558823261</stddev>
              <dynamic_bias_stddev>0.05885688582916525</dynamic_bias_stddev>
            </noise>
          </x>
          <y>
            <noise type="gaussian">
              <mean>0</mean>
              <stddev>0.144874558823261</stddev>
              <dynamic_bias_stddev>0.05885688582916525</dynamic_bias_stddev>
            </noise>
          </y>
          <z>
            <noise type="gaussian">
              <mean>0</mean>
              <stddev>0.144874558823261</stddev>
              <dynamic_bias_stddev>0.05885688582916525</dynamic_bias_stddev>
            </noise>
          </z>
        </linear_acceleration>
      </imu>
    </sensor>
  </gazebo>
  <gazebo reference="front_camera_imu_link">
    <sensor name="magnetometer_sensor" type="magnetometer">
      <always_on>true</always_on>
      <update_rate>200.0</update_rate>
      <magnetometer>
        <x>
          <noise type="gaussian">
            <stddev>1.4e-6</stddev>
          </noise>
        </x>
        <y>
          <noise type="gaussian">
            <stddev>1.4e-6</stddev>
          </noise>
        </y>
        <z>
          <noise type="gaussian">
            <stddev>1.4e-6</stddev>
          </noise>
        </z>
      </magnetometer>
